# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore built isos that we copy to the project root
*.iso

# Pre-commit is auto generated in the flake
.pre-commit-config.yaml

# Just load latest plugins
lazy-lock.json

# Claude Code runtime state (scheduled-tasks lockfile, worktrees, local
# settings). Listed as .claude/* rather than .claude/ so git still descends
# into the directory and the negation below can take effect.
.claude/*
# ...except the skills, which are repo workflow and are checked in.
!.claude/skills/
